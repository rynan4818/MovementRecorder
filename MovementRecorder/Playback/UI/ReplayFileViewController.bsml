<bg>
  <vertical spacing="0.5" pad="2">
    <text text="~chart" rich-text="false" font-size="4" align="Center" pref-height="5" overflow-mode="Ellipsis"/>
    <text text="~selected-file" font-color="~selection-color" rich-text="false" font-size="3" pref-height="5" overflow-mode="Ellipsis"/>
    <horizontal spacing="2" pref-height="6">
      <button text="一覧を更新" on-click="refresh" interactable="~can-edit" pref-width="27"/>
      <button text="キャッシュ再構築" on-click="rebuild" interactable="~can-edit" pref-width="35"/>
      <text text="~distance-heading" font-size="2.8" align="Right"/>
    </horizontal>
    <vertical active="~show-files" spacing="1" pref-height="41">
      <custom-list id="files" contents="rows" select-cell="select-row" visible-cells="3" cell-size="10" list-width="110" show-scrollbar="true">
        <horizontal pref-width="108" pref-height="10">
          <text id="row-info" text="~title" rich-text="false" word-wrapping="false" font-size="3" align="Left" pref-width="84" pref-height="10" overflow-mode="Ellipsis"/>
          <text id="row-distance" text="~distance" rich-text="false" font-size="4" align="Right" pref-width="21" pref-height="10"/>
        </horizontal>
      </custom-list>
      <text text="~details" font-color="~info-color" rich-text="false" font-size="2.4" pref-height="10"/>
    </vertical>
    <vertical active="~show-settings" spacing="0.5" pref-height="41">
      <checkbox-setting text="No Fail（最後まで鑑賞）" value="no-fail" interactable="~can-edit" apply-on-change="true" pref-height="6"/>
      <checkbox-setting text="コピー元アバターを表示" value="show-source-avatar" interactable="~can-edit" apply-on-change="true" pref-height="6"/>
      <checkbox-setting text="コピー元アバターにHMDオフセットを適用" value="offset-source-avatar" hover-hint="コピー元を表示する場合だけ適用します。変更は次のリプレイ開始時に反映されます。" interactable="~can-edit" apply-on-change="true" pref-height="6"/>
      <increment-setting text="鑑賞位置・左右 (m)" value="observer-x" interactable="~can-edit" min="-5" max="5" increment="0.1" apply-on-change="true" pref-height="6"/>
      <increment-setting text="鑑賞位置・上下 (m)" value="observer-y" interactable="~can-edit" min="-3" max="3" increment="0.1" apply-on-change="true" pref-height="6"/>
      <increment-setting text="鑑賞位置・前後 (m)" value="observer-z" interactable="~can-edit" min="-8" max="5" increment="0.1" apply-on-change="true" pref-height="6"/>
    </vertical>
    <text text="~status" rich-text="false" font-size="2.8" pref-height="6"/>
    <horizontal spacing="2" pref-height="8">
      <button text="詳細" on-click="details-toggle" pref-width="16"/>
      <button text="~settings-label" on-click="settings-toggle" pref-width="26"/>
      <button text="リプレイ開始" on-click="start-replay" interactable="~can-replay" pref-width="32"/>
      <button text="読込中止" on-click="cancel-load" interactable="~can-cancel" pref-width="25"/>
    </horizontal>
  </vertical>
</bg>
