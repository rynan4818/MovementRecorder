<bg>
  <vertical spacing="1" pad="2">
    <text text="~chart" font-size="4" align="Center" pref-height="5" overflow-mode="Ellipsis"/>
    <horizontal spacing="2" pref-height="6">
      <button text="一覧を更新" on-click="refresh" pref-width="27"/>
      <button text="キャッシュ再構築" on-click="rebuild" pref-width="35"/>
      <text text="~distance-heading" font-size="2.8" align="Right"/>
    </horizontal>
    <vertical active="~show-files" spacing="1" pref-height="41">
      <custom-list id="files" contents="rows" select-cell="select-row" visible-cells="3" cell-size="10" list-width="110" show-scrollbar="true">
        <horizontal pref-width="108" pref-height="10">
          <vertical pref-width="81" spacing="0">
            <text text="~title" font-size="3.5" pref-height="5" overflow-mode="Ellipsis"/>
            <text text="~detail" font-size="2.7" pref-height="4" overflow-mode="Ellipsis"/>
          </vertical>
          <text text="~distance" font-size="4" align="Right" pref-width="24"/>
        </horizontal>
      </custom-list>
      <text text="~details" font-size="2.4" pref-height="10"/>
    </vertical>
    <vertical active="~show-settings" spacing="1" pref-height="41">
      <text text="現在の譜面設定・1.0倍で鑑賞します。記録時の設定はファイルに含まれません。" font-size="2.8" pref-height="7"/>
      <checkbox-setting text="No Fail（最後まで鑑賞）" value="no-fail" apply-on-change="true" pref-height="7"/>
      <increment-setting text="鑑賞位置・左右 (m)" value="observer-x" min="-5" max="5" increment="0.5" apply-on-change="true" pref-height="7"/>
      <increment-setting text="鑑賞位置・上下 (m)" value="observer-y" min="-3" max="3" increment="0.5" apply-on-change="true" pref-height="7"/>
      <increment-setting text="鑑賞位置・前後 (m)" value="observer-z" min="-8" max="5" increment="0.5" apply-on-change="true" pref-height="7"/>
    </vertical>
    <text text="~status" font-size="2.8" pref-height="6"/>
    <horizontal spacing="2" pref-height="8">
      <button text="詳細" on-click="details-toggle" pref-width="16"/>
      <button text="~settings-label" on-click="settings-toggle" pref-width="26"/>
      <button text="この記録を選択" on-click="confirm" interactable="~can-select"/>
    </horizontal>
  </vertical>
</bg>
